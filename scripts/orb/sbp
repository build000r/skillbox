#!/usr/bin/env bash
# Minimal Orb-facing SBP front door. The host wrapper remains scripts/sbp.
set -uo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -z "${SBP_REMOTE:-}" ]]; then
  printf '%s\n' 'sbp orb: SBP_REMOTE is required' >&2
  exit 2
fi
exec python3 "${script_dir}/lib/sbp_client.py" --remote "${SBP_REMOTE}" "$@"
