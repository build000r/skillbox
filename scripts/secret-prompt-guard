#!/usr/bin/env python3
"""Refuse to launch a command whose argv carries a credential-shaped literal.

On 2026-07-30 a `tag:orb` Tailscale auth key was written directly into an
`amp -x` prompt. The key then existed in a place nobody can retract: a shell
history, a process table, an agent transcript, and whatever the agent wrote
downstream. It had to be rotated. Rotation is the expensive half; the cheap half
is never letting the literal onto the command line in the first place.

This is a pre-exec wrapper. Put it in front of the command:

    secret-prompt-guard -- amp -x "…"
    secret-prompt-guard -- ntm send …

Clean argv is exec'd transparently, so the wrapped command keeps its own exit
code and behaviour. A credential-shaped argument is refused with exit
``EXIT_BLOCKED`` and the command never runs.

Three properties worth stating, because a guard that gets them wrong is worse
than none:

**It never prints what it found.** A guard that echoes the offending value to
stderr copies the secret into the very transcript the guard exists to keep clean.
Findings carry the shape's name, the argv index, and a short SHA-256 fingerprint
— enough to identify *which* value tripped it without reproducing it.

**Blocking is the default; the escape hatch is explicit and named.**
``SKILLBOX_ALLOW_SECRET_PROMPT=1`` downgrades a block to a warning, for the case
where a shape genuinely is a false positive. Silent pass is never an option:
the override still prints the finding, so an override is visible in the
transcript rather than invisible.

**It reads argv, and says so.** ``amp -x "$(cat key.txt)"`` puts the literal in
argv *after* the shell expands it, so the wrapper does see that. But a command
that reads the secret from a file descriptor itself, or receives it over stdin
without ``--scan-stdin``, is outside what argv inspection can observe. This
guard narrows a well-attested hole; it is not a claim that the hole is closed.

The correct delivery path — the thing this guard exists to push people toward —
is `amp secrets set --user`, with the value reaching the process through the
environment rather than through a prompt. See docs/orb-tailnet-bootstrap.md.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import sys
from dataclasses import dataclass
from typing import Any, Iterable, Sequence

GUARD_SCHEMA = "skillbox.secret-prompt-guard/v1"

EXIT_OK = 0
#: Distinct from 1/2 so a caller can tell "the guard refused" from "the wrapped
#: command failed" or "you used the guard wrong".
EXIT_BLOCKED = 3
EXIT_USAGE = 2

OVERRIDE_ENV = "SKILLBOX_ALLOW_SECRET_PROMPT"


@dataclass(frozen=True)
class Shape:
    """One credential shape, and why it matters."""

    name: str
    pattern: re.Pattern[str]
    summary: str


#: The shapes the bead enumerates. Each is anchored on a vendor-assigned prefix
#: rather than on entropy: prefix matching has a far lower false-positive rate
#: than "looks random", and these prefixes are exactly what leaks in practice.
SHAPES: tuple[Shape, ...] = (
    Shape(
        name="tailscale_auth_key",
        pattern=re.compile(r"tskey-auth-[A-Za-z0-9]{8,}-"),
        summary="Tailscale auth key (the 2026-07-30 burn)",
    ),
    Shape(
        name="openai_style_key",
        pattern=re.compile(r"sk-[A-Za-z0-9]{20,}"),
        summary="sk- prefixed API key",
    ),
    Shape(
        name="aws_access_key_id",
        pattern=re.compile(r"AKIA[0-9A-Z]{16}"),
        summary="AWS access key id",
    ),
    Shape(
        name="github_pat",
        pattern=re.compile(r"ghp_[A-Za-z0-9]{30,}"),
        summary="GitHub personal access token",
    ),
    Shape(
        name="bearer_token",
        pattern=re.compile(r"Bearer [A-Za-z0-9._-]{40,}"),
        summary="Bearer token in a literal header",
    ),
)


@dataclass(frozen=True)
class Finding:
    """What tripped, where — never the value itself."""

    shape: str
    summary: str
    argv_index: int
    fingerprint: str

    def to_payload(self) -> dict[str, Any]:
        return {
            "shape": self.shape,
            "summary": self.summary,
            "argv_index": self.argv_index,
            "fingerprint": self.fingerprint,
        }

    def render(self) -> str:
        return (
            f"  argv[{self.argv_index}]: {self.shape} — {self.summary} "
            f"(sha256:{self.fingerprint})"
        )


def fingerprint(value: str) -> str:
    """A short, one-way handle so two reports can be compared, never reversed."""

    return hashlib.sha256(value.encode("utf-8")).hexdigest()[:12]


def scan_value(value: str, index: int = 0) -> list[Finding]:
    """Every credential shape found in one string."""

    findings: list[Finding] = []
    for shape in SHAPES:
        for match in shape.pattern.finditer(value):
            findings.append(
                Finding(
                    shape=shape.name,
                    summary=shape.summary,
                    argv_index=index,
                    # Fingerprint the MATCH, not the whole argument: the
                    # argument may be a long prompt, and the identity that
                    # matters is the credential inside it.
                    fingerprint=fingerprint(match.group(0)),
                )
            )
    return findings


def scan_argv(argv: Sequence[str]) -> list[Finding]:
    findings: list[Finding] = []
    for index, value in enumerate(argv):
        findings.extend(scan_value(value, index))
    return findings


def override_active(environ: dict[str, str] | None = None) -> bool:
    source = os.environ if environ is None else environ
    return str(source.get(OVERRIDE_ENV, "")).strip().lower() in {"1", "true", "yes"}


REMEDIATION = (
    f"Do not put credentials in a prompt or on a command line. Store the value\n"
    f"once and let it reach the process through the environment:\n"
    f"\n"
    f"    printf '%s' \"$VALUE\" | amp secrets set --user <NAME> --secret "
    f"--data-file -\n"
    f"\n"
    f"then reference <NAME> in the prompt, never the value. `--data-file -` "
    f"matters:\n"
    f"it keeps the secret out of argv during the `set` itself.\n"
    f"See docs/orb-tailnet-bootstrap.md, 'Transitional auth-key delivery' and\n"
    f"'3. Prompt embedding is forbidden'.\n"
    f"If this is genuinely a false positive, re-run with {OVERRIDE_ENV}=1 "
    f"(the finding is still printed, so the override stays visible)."
)


def report(findings: Iterable[Finding], *, as_json: bool, overridden: bool) -> None:
    findings = list(findings)
    if as_json:
        json.dump(
            {
                "schema": GUARD_SCHEMA,
                "ok": not findings or overridden,
                "blocked": bool(findings) and not overridden,
                "overridden": overridden,
                "findings": [item.to_payload() for item in findings],
                "remediation": REMEDIATION,
            },
            sys.stdout,
            indent=2,
            sort_keys=True,
        )
        sys.stdout.write("\n")
        return
    if not findings:
        return
    headline = (
        "secret-prompt-guard: WARNING (override active) — credential-shaped "
        "argument(s) found:"
        if overridden
        else "secret-prompt-guard: BLOCKED — credential-shaped argument(s) found:"
    )
    print(headline, file=sys.stderr)
    for item in findings:
        print(item.render(), file=sys.stderr)
    print("", file=sys.stderr)
    print(REMEDIATION, file=sys.stderr)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="secret-prompt-guard",
        description=(
            "Refuse to exec a command whose argv carries a credential-shaped "
            "literal. Clean commands are exec'd unchanged."
        ),
    )
    parser.add_argument(
        "--check-only",
        action="store_true",
        help="Scan and report, but never exec (for tests and CI).",
    )
    parser.add_argument(
        "--scan-stdin",
        action="store_true",
        help="Also scan text on stdin (for hook use); implies --check-only.",
    )
    parser.add_argument("--format", choices=("text", "json"), default="text")
    parser.add_argument(
        "command",
        nargs=argparse.REMAINDER,
        help="The command to run, after `--`.",
    )
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(list(argv) if argv is not None else None)

    command = list(args.command)
    if command and command[0] == "--":
        command = command[1:]

    scanned: list[str] = list(command)
    if args.scan_stdin:
        scanned.append(sys.stdin.read())

    if not scanned:
        print(
            "secret-prompt-guard: nothing to scan; usage: "
            "secret-prompt-guard -- <command> [args...]",
            file=sys.stderr,
        )
        return EXIT_USAGE

    findings = scan_argv(scanned)
    overridden = override_active()
    report(findings, as_json=args.format == "json", overridden=overridden)

    if findings and not overridden:
        return EXIT_BLOCKED
    if args.check_only or args.scan_stdin or not command:
        return EXIT_OK

    # Clean (or overridden): become the real command so it keeps its own exit
    # code, signals, and stdio. exec rather than subprocess so nothing about the
    # wrapped command's behaviour changes.
    try:
        os.execvp(command[0], command)
    except OSError as error:
        print(
            f"secret-prompt-guard: could not exec {command[0]!r}: "
            f"{type(error).__name__}",
            file=sys.stderr,
        )
        return EXIT_USAGE
    return EXIT_OK  # pragma: no cover - execvp does not return


if __name__ == "__main__":
    sys.exit(main())
