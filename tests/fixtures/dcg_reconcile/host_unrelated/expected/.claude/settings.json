{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(br show *)"
    ]
  },
  "model": "claude-opus-5[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/sandbox/.local/bin/rch"
          }
        ]
      },
      {
        "matcher": "mcp__skillbox-operator__operator_teardown",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/guard-destructive-op.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "@DCG_BIN@"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /opt/forge/score.py"
          }
        ]
      }
    ]
  },
  "skipDangerousModePermissionPrompt": true
}
