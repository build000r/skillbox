#!/usr/bin/env bash
# Fast, offline AO-005 wake hook. No repair, networking, or background work.
set -Eeuo pipefail
ROOT="$(cd "${BASH_SOURCE[0]%/*}/.." && pwd)"
cd "$ROOT"
STATE_DIR="${AGENT_STATE_DIR:-$ROOT/.skillbox-state/project-orb/hook-state}"
LOG_DIR="${AGENT_LOG_DIR:-$ROOT/.skillbox-state/project-orb/hook-logs}"
STATUS_FILE="$STATE_DIR/resume-status.json"
LOG_FILE="$LOG_DIR/resume.log"
printf -v START '%(%s)T' -1
FAILURE_CLASS=setup
REASON_CODE=resume_unexpected
umask 077
fallback_status() {
  local status="$1" failure="$2" reason="$3" code="$4"
  printf 'AGENT_RESUME_RESULT_JSON {"schema_version":"skillbox.amp-project-orb.hook-status/1","kind":"skillbox.agent_hook_status","script":"resume","status":"%s","failure_class":"%s","reason_code":"%s","exit_code":%s,"duration_seconds":0}\n' \
    "$status" "$failure" "$reason" "$code" >&2
}
command -v timeout >/dev/null 2>&1 || {
  printf 'skillbox-orb-resume: required local command timeout is missing\n' >&2
  fallback_status error dependency timeout_command_missing 20
  exit 20
}
command -v python3 >/dev/null 2>&1 || {
  printf 'skillbox-orb-resume: required local command python3 is missing\n' >&2
  fallback_status error dependency python_missing 20
  exit 20
}
timeout --signal=TERM --kill-after=1 "${SKILLBOX_ORB_FS_TIMEOUT_SECONDS:-3}s" \
  "$ROOT/scripts/orb/orb_readiness.py" prepare-hook \
  --state-dir "$STATE_DIR" --log-dir "$LOG_DIR" --script resume || {
    printf 'skillbox-orb-resume: could not prepare private hook state\n' >&2
    fallback_status error setup hook_state_invalid 10
    exit 10
  }
emit_status() {
  local rc="$1" status=error; [[ "$rc" -eq 0 ]] && status=ok
  if STATUS_FILE="$STATUS_FILE" SCRIPT=resume STATUS="$status" FAILURE_CLASS="$FAILURE_CLASS" \
    REASON_CODE="$REASON_CODE" EXIT_CODE="$rc" START="$START" \
    timeout --signal=TERM --kill-after=1 "${SKILLBOX_ORB_STATUS_TIMEOUT_SECONDS:-2}s" \
    "$ROOT/scripts/orb/orb_readiness.py" write-status >/dev/null 2>&1; then
    [[ -f "$STATUS_FILE" && ! -L "$STATUS_FILE" ]] \
      && printf 'AGENT_RESUME_RESULT_JSON %s\n' "$(<"$STATUS_FILE")" >&2
  else
    local fallback_code="$rc"
    [[ "$fallback_code" -eq 0 ]] && fallback_code=50
    fallback_status error validation status_write_failed "$fallback_code"
    if [[ "$rc" -eq 0 ]]; then
      trap - EXIT
      exit 50
    fi
  fi
}
trap 'rc=$?; emit_status "$rc"' EXIT
fail() { FAILURE_CLASS="$1"; REASON_CODE="$2"; printf 'skillbox-orb-resume: %s\n' "$2" >&2; exit "$3"; }
command -v git >/dev/null 2>&1 || fail dependency git_missing 20
free_kb="$(
  timeout --signal=TERM --kill-after=1 "${SKILLBOX_ORB_DISK_TIMEOUT_SECONDS:-3}s" \
    python3 -c 'import shutil; print(shutil.disk_usage("/").free // 1024)'
)" || {
  rc=$?
  [[ "$rc" -eq 124 || "$rc" -eq 137 ]] && fail capacity disk_probe_timeout 30
  fail capacity disk_probe_failed 30
}
[[ "$free_kb" =~ ^[0-9]+$ ]] || fail capacity disk_probe_failed 30
min_gb="${SKILLBOX_ORB_RESUME_MIN_FREE_GB:-6}"
(( free_kb >= min_gb * 1024 * 1024 )) || fail capacity disk_capacity_low 30
timeout --signal=TERM --kill-after=1 "${SKILLBOX_ORB_RESUME_IDENTITY_TIMEOUT_SECONDS:-2}s" \
  "$ROOT/scripts/orb/orb_readiness.py" ensure-identity --output "$STATE_DIR/orb-resume-id" >>"$LOG_FILE" 2>&1 || {
    rc=$?; [[ "$rc" -eq 124 || "$rc" -eq 137 ]] && fail validation identity_timeout 50
    fail validation identity_failed 50
  }
timeout --signal=TERM --kill-after=1 "${SKILLBOX_ORB_RESUME_READINESS_TIMEOUT_SECONDS:-4}s" \
  "$ROOT/scripts/orb/orb_readiness.py" collect --context resume --output "$STATE_DIR/orb-readiness.json" >>"$LOG_FILE" 2>&1 || {
    rc=$?; [[ "$rc" -eq 124 || "$rc" -eq 137 ]] && fail validation readiness_timeout 50
    fail validation readiness_failed 50
  }
FAILURE_CLASS=none; REASON_CODE=resume_ready
