#!/usr/bin/env bash
# Bounded, idempotent AO-005 project-Orb setup. This hook is deliberately offline.
set -Eeuo pipefail

ROOT="$(cd "${BASH_SOURCE[0]%/*}/.." && pwd)"
cd "$ROOT"
STATE_DIR="${AGENT_STATE_DIR:-$ROOT/.skillbox-state/project-orb/hook-state}"
LOG_DIR="${AGENT_LOG_DIR:-$ROOT/.skillbox-state/project-orb/hook-logs}"
STATUS_FILE="$STATE_DIR/setup-status.json"
LOG_FILE="$LOG_DIR/setup.log"
printf -v START '%(%s)T' -1
FAILURE_CLASS=setup
REASON_CODE=setup_unexpected
DETAIL='setup did not complete'
umask 077

fallback_status() {
  local status="$1" failure="$2" reason="$3" code="$4"
  printf 'AGENT_SETUP_RESULT_JSON {"schema_version":"skillbox.amp-project-orb.hook-status/1","kind":"skillbox.agent_hook_status","script":"setup","status":"%s","failure_class":"%s","reason_code":"%s","exit_code":%s,"duration_seconds":0}\n' \
    "$status" "$failure" "$reason" "$code" >&2
}
command -v timeout >/dev/null 2>&1 || {
  printf 'skillbox-orb-setup: required local command timeout is missing\n' >&2
  fallback_status error dependency timeout_command_missing 20
  exit 20
}
command -v python3 >/dev/null 2>&1 || {
  printf 'skillbox-orb-setup: required local command python3 is missing\n' >&2
  fallback_status error dependency python_missing 20
  exit 20
}
timeout --signal=TERM --kill-after=1 "${SKILLBOX_ORB_FS_TIMEOUT_SECONDS:-3}s" \
  "$ROOT/scripts/orb/orb_readiness.py" prepare-hook \
  --state-dir "$STATE_DIR" --log-dir "$LOG_DIR" --script setup || {
    printf 'skillbox-orb-setup: could not prepare private hook state\n' >&2
    fallback_status error setup hook_state_invalid 10
    exit 10
  }

emit_status() {
  local rc="$1" status=error
  [[ "$rc" -eq 0 ]] && status=ok
  if STATUS_FILE="$STATUS_FILE" SCRIPT=setup STATUS="$status" FAILURE_CLASS="$FAILURE_CLASS" \
    REASON_CODE="$REASON_CODE" EXIT_CODE="$rc" START="$START" \
    timeout --signal=TERM --kill-after=1 "${SKILLBOX_ORB_STATUS_TIMEOUT_SECONDS:-2}s" \
    "$ROOT/scripts/orb/orb_readiness.py" write-status >/dev/null 2>&1; then
    [[ -f "$STATUS_FILE" && ! -L "$STATUS_FILE" ]] \
      && printf 'AGENT_SETUP_RESULT_JSON %s\n' "$(<"$STATUS_FILE")" >&2
  else
    local fallback_code="$rc"
    [[ "$fallback_code" -eq 0 ]] && fallback_code=50
    fallback_status error validation status_write_failed "$fallback_code"
    if [[ "$rc" -eq 0 ]]; then
      trap - EXIT
      exit 50
    fi
  fi
}
trap 'rc=$?; emit_status "$rc"' EXIT

fail() { FAILURE_CLASS="$1"; REASON_CODE="$2"; DETAIL="$3"; printf 'skillbox-orb-setup: %s\n' "$DETAIL" >&2; exit "$4"; }
run_bounded() {
  local seconds="$1" reason="$2" klass="$3" code="$4"; shift 4
  timeout --signal=TERM --kill-after=1 "${seconds}s" "$@" >>"$LOG_FILE" 2>&1 || {
    local rc=$?
    [[ "$rc" -eq 124 || "$rc" -eq 137 ]] && fail "$klass" "$reason" "$reason" "$code"
    fail "$klass" "${reason%_timeout}_failed" "${reason%_timeout} failed" "$code"
  }
}

command -v git >/dev/null 2>&1 || fail dependency git_missing 'required local command git is missing' 20

free_kb="$(
  timeout --signal=TERM --kill-after=1 "${SKILLBOX_ORB_DISK_TIMEOUT_SECONDS:-3}s" \
    python3 -c 'import shutil; print(shutil.disk_usage("/").free // 1024)'
)" || {
  rc=$?
  [[ "$rc" -eq 124 || "$rc" -eq 137 ]] && fail capacity disk_probe_timeout 'local disk capacity probe timed out' 30
  fail capacity disk_probe_failed 'local disk capacity probe failed' 30
}
[[ "$free_kb" =~ ^[0-9]+$ ]] || fail capacity disk_probe_failed 'local disk capacity probe was invalid' 30
min_gb="${SKILLBOX_ORB_MIN_FREE_GB:-8}"
(( free_kb >= min_gb * 1024 * 1024 )) || fail capacity disk_capacity_low 'insufficient fixed Orb disk capacity' 30

run_bounded "${SKILLBOX_ORB_COMPILE_TIMEOUT_SECONDS:-45}" compileall_timeout validation 50 \
  python3 -m compileall -q -x '(/\.git/|/builds/|/data/|/node_modules/|/__pycache__/)' .env-manager scripts tests
run_bounded "${SKILLBOX_ORB_UNITTEST_TIMEOUT_SECONDS:-45}" unittest_timeout validation 50 \
  python3 -m unittest tests.test_agent_ops_adapters -q
run_bounded "${SKILLBOX_ORB_IDENTITY_TIMEOUT_SECONDS:-3}" identity_timeout validation 50 \
  "$ROOT/scripts/orb/orb_readiness.py" ensure-identity --output "$STATE_DIR/orb-resume-id"
run_bounded "${SKILLBOX_ORB_READINESS_TIMEOUT_SECONDS:-5}" readiness_timeout validation 50 \
  "$ROOT/scripts/orb/orb_readiness.py" collect --context setup --output "$STATE_DIR/orb-readiness.json"

FAILURE_CLASS=none
REASON_CODE=setup_ready
DETAIL='setup complete'
exit 0
